{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "az-sentinel-api",
  "main": "src/index.ts",
  // Phải <= ngày mà workerd đã cài hỗ trợ. Cập nhật khi nâng wrangler.
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Part 1 (spike): bật meta rows_written/rows_read trong phản hồi ingest. Tắt ở staging/prod.
  "vars": { "INGEST_DEBUG_META": "1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "az-sentinel-db",
      // Local dev/test dùng ID giả này. Trước khi deploy (P1-20) thay bằng ID thật
      // từ `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Plan 3B: hub live. Gói free bắt buộc SQLite-backed (new_sqlite_classes); hub không dùng
  // storage nên không tốn dòng ghi của DO.
  "durable_objects": { "bindings": [{ "name": "LIVE_HUB", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1-live-hub", "new_sqlite_classes": ["LiveHub"] }]
  // Part 4: thêm "routes" khi có domain; Part 5: thêm "triggers.crons".
}
