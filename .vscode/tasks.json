{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MQL5: Compile current file",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\ea\\compile.ps1",
                "-Source",
                "${file}"
            ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": {
                "owner": "mql5",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?)\\((\\d+),(\\d+)\\)\\s*:\\s*(error|warning)\\s*(\\d+)?:?\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        },
        {
            "label": "MQL5: Syntax check current file",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\ea\\compile.ps1",
                "-Source",
                "${file}",
                "-Syntax"
            ],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": {
                "owner": "mql5",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?)\\((\\d+),(\\d+)\\)\\s*:\\s*(error|warning)\\s*(\\d+)?:?\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        }
    ]
}
